# Copy to .env for local use (never commit .env).
# On Vercel, add these under Project -> Settings -> Environment Variables instead.

# Hosted database (required on Vercel). Leave unset locally to use a local SQLite file.
TURSO_DATABASE_URL=libsql://your-database-your-org.turso.io
TURSO_AUTH_TOKEN=

# Creates / updates the Senior Intercessor (admin) account on startup. Password: 8+ characters.
SENIOR_EMAIL=pastor@yourchurch.org
SENIOR_PASSWORD=change-me-please
SENIOR_NAME=Full Name

# Long random string used to sign login tokens (recommended). Generate with: openssl rand -hex 32
JWT_SECRET=
